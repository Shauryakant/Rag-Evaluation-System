# Groq API Key for grounded LLM answer generation (optional for retrieval/evaluation, required for live generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# CORS allowed origins (comma-separated, default is http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
